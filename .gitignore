# ---------------------------------------------------------------------------
# Bundled virtual environment (contains torch/pygame/... ~5.7 GB) - never commit
# ---------------------------------------------------------------------------
For_Test/
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Third-party reference material (kept locally for reading only)
#   Outside/<category>/<project>/ : locally cloned reference projects
#   (Algo / Bullet / Camera), ~1.4 GB, each with its own licence.
#
#   The cloned CODE is never committed, but the hand-written analysis notes
#   (Outside/<category>/<project>/tech.md) are the author's own work and ARE
#   tracked - that is what the re-include lines below do.
# ---------------------------------------------------------------------------
Outside/*
!Outside/Algo/
!Outside/Bullet/
!Outside/Camera/
Outside/*/*
!Outside/*/*/
Outside/*/*/*
!Outside/*/*/tech.md
#   Keiki-master  : no LICENSE file found -> [LICENSE_REVIEW_REQUIRED]
#   TostEngine... : MIT upstream, but it is a separate repository (~594 MB)
# Push these only if you have checked the licence question; see
# bullet_sim/docs/OPEN_SOURCE_REFERENCES.md
# ---------------------------------------------------------------------------
# (leading slash = repo root only, so these do not swallow the copies that
#  now live under Outside/Bullet/)
/Keiki-master/
/TostEngine-cinder-bullethell-main/
*.zip

# ---------------------------------------------------------------------------
# Generated simulation artifacts
# ---------------------------------------------------------------------------
data/
benchmarks_output/
*.npz
*.npy
*.bin
*.dat

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
